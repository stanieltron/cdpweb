<!-- tokenDetails.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Token Details</title>
  <link rel="stylesheet" href="styles.css">
  <script src="https://cdn.plot.ly/plotly-3.0.1.min.js"></script>
</head>
<body>

  <div id="backgroundw" class="flex-container">
    <div class="flex-item">
      <div id="logo"><a href="/"> <img src="/CDI.png" alt="CDI Logo" class="logo"> </a></div>
    </div> <!-- Takes the remaining width -->
    <div class="flex-item-mid">
      <div class="container" id="container">
        <h1 class="token-details-header">
          <img src="<%= tokenDetails.logoPath %>" alt="<%= tokenDetails.name %> Logo" class="token-logo">
          <strong class="name-label">
            <%= tokenDetails.name %>
          </strong>
          <span><img src="<%= tokenDetails.areaIconPath %>" alt="<%= tokenDetails.name %> Logo" class="token-area"></span>
          <span><img src="<%= tokenDetails.promiseIconPath %>" alt="<%= tokenDetails.name %> Logo" class="token-promise"></span>
        </h1>
        <div class="separator"></div>
        <div class="token-info">
          <p><strong class="symbol-label">Symbol:</strong>
            <%= tokenDetails.symbol %>
          </p>
          <p><strong class="symbol-label">Total Funds:</strong>
            <%= tokenDetails.totalFunds %>
          </p>
          <p><strong class="symbol-label">Registry Address:</strong>
            <%= tokenDetails.registryAddress %>
          </p>
          <p><strong class="symbol-label">Token Address:</strong>
            <%= tokenDetails.tokenAddress %>
          </p>
          <p><strong class="symbol-label">Total Supply:</strong>
            <%= tokenDetails.totalSupply / 1000000 %>
          </p>
          <p><strong class="symbol-label">Home page:</strong>
            <%= tokenDetails.name %>homepage
          </p>
        </div>
        <div class="separator"></div>
        <div class="token-description">
          <p>
            <%= tokenDetails.description %>
          </p>
        </div>

        <div class="separator"></div>
        <div class="separator"></div>
        <div class="descr">funds added in time. This can tell you about projects consistency of generating and distributing profits as an important part of your decision to buy</div>
        <div id="token-chart-<%= tokenDetails.tokenAddress %>" class="chart-container"></div>
        <div class="separator"></div>
        <div class="more"> More functions when owning the token, try BUY</div>
        <div class="button-container">
          <a id="fundButton" href="#" class="button">Fund</a>
          <a id="buyButton" href="#" class="button">Buy</a>
          
          <a id="stakeButton" href="#" class="button">(RE)Stake</a>
          <a id="unstakeButton" href="#" class="button">Unstake</a>
          <!-- <a id="burnButton" href="#" class="button">Burn</a> -->
        </div>
        <div class="separator"></div>
        
      
        <div id="stakeContainer" style="display: none;">
          <%- include('stake', { tokenDetails: tokenDetails }) %>
        </div>
        <div id="unstakeContainer" style="display: none;">
          <%- include('unstake', { tokenDetails: tokenDetails }) %>
        </div>
        <div id="burnContainer" style="display: none;">
          <%- include('burn', { tokenDetails: tokenDetails }) %>
        </div>
        <div id="buyContainer" style="display: none;">
          <%- include('buy', { tokenDetails: tokenDetails }) %>
        </div>
        <div id="fundContainer" style="display: none;">
          <%- include('fund', { tokenDetails: tokenDetails }) %>
        </div>
      </div>
    </div>
    <div class="flex-item">
      <div class="walletArea">
        <div id="meta" class="connectButton">

        </div>
        <div id="whenConnected" style="display: none;">
          <div id="addressDisplay"></div> <!-- Add a div to display the address -->
          <div id="fundsDisplay"></div>
          
          <div id="tokenBalances">
            <h3>your part of</h3>
            <ul id="tokenBalanceList"></ul>
          </div>
        </div>
      </div>
    </div> <!-- Takes the remaining width -->
  </div>
</body>
</html>




<script>
  // Create an object to store token details mapped to token addresses
  window.tokenInfos = {
    <% Object.keys(tokenRegistryData).forEach(tokenAddress => { %>
    '<%= tokenRegistryData[tokenAddress].tokenAddress %>': {
      registryAddress: '<%= tokenRegistryData[tokenAddress].registryAddress %>',
      name: '<%= tokenRegistryData[tokenAddress].name %>',
      symbol: '<%= tokenRegistryData[tokenAddress].symbol %>',
      decimals: '<%= tokenRegistryData[tokenAddress].decimals %>',
      logoPath: '<%= tokenRegistryData[tokenAddress].logoPath %>',
      totalFunds: '<%=  tokenRegistryData[tokenAddress].totalFunds %>',
      totalSupply: '<%=  tokenRegistryData[tokenAddress].totalSupply %>',
      buyLink: '<%=  tokenRegistryData[tokenAddress].buyLink %>',
      },
    <% }); %>
  };
</script>

<script>
  window.tokenDetails = {
    tokenAddress: '<%= tokenDetails.tokenAddress %>',
    registryAddress: '<%= tokenDetails.registryAddress %>',
    name: '<%= tokenDetails.name %>',
    decimals: '<%= tokenDetails.decimals %>',
    symbol: '<%= tokenDetails.symbol %>',
    logoPath: '<%= tokenDetails.logoPath %>',
    totalFunds: '<%= tokenDetails.totalFunds %>',
    totalSupply: '<%= tokenDetails.totalSupply %>',
    buyLink: '<%= tokenDetails.buyLink %>'
  };
</script>

<script>
  // Get fundings and prepare data for plotting
  var blockNumbers = [];
  var values = [];
  var dates = [];
  
  // Get the latest date from the fundings and calculate the last 30 days
  <% tokenDetails.fundings.forEach((funding, index, array) => { %>
     fundingDate = '<%= funding.date %>';
     fundingValue = <%= funding.value  %>; // Convert value from wei to ETH

    // Collect the funding value and date
    blockNumbers.push(fundingDate);
    values.push(fundingValue);
    dates.push(fundingDate);
  <% }); %>

  // Get current date and create an array for the last 30 days
  const today = new Date();
  const last30Days = [];

  for (let i = 30; i >= 0; i--) {
    const date = new Date(today);
    date.setDate(today.getDate() - i);
    last30Days.push(date.toISOString().slice(0, 10)); // Format as YYYY-MM-DD
  }

  // Ensure that every day has a value, defaulting to 0 if no funding occurred on that day
  const fundingByDate = {};
  last30Days.forEach(date => {
    fundingByDate[date] = 0;
  });

  // Populate funding values by date
  blockNumbers.forEach((date, idx) => {
    if (fundingByDate[date] !== undefined) {
      fundingByDate[date] = values[idx];
    }
  });

  // Prepare the funding sums for the chart
  const xValues = last30Days;
  const yValues = last30Days.map(date => fundingByDate[date]);

  // Create the chart data
  const tokenData = [{
    x: xValues,
    y: yValues,
    type: 'bar', // Bar chart for individual fundings
    marker: {
      color: 'rgba(0, 200, 255, 0.5)',
    }
  }];

  // Layout for the chart
  const layout = {
    title: 'Daily Fundings (ETH)',
    xaxis: {
      title: 'Date',
      tickmode: 'array',
      tickvals: last30Days,
      ticktext: last30Days,
    },
    yaxis: {
      title: 'Funds (ETH)',
      zeroline: true,
    },
    plot_bgcolor: "transparent",
    paper_bgcolor: "transparent",
    height: 500,
    displayModeBar: false
  };

  // Create the plot
  
  Plotly.newPlot('token-chart-<%= tokenDetails.tokenAddress %>', tokenData, layout, { displayModeBar: false });
</script>


<script src="scripts.js"></script>
<script src="scriptsTokenDetails.js"></script>
<script src="https://cdn.jsdelivr.net/npm/web3@1.5.0/dist/web3.min.js"></script>

